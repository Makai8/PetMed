# Copy this file to src/.env and fill in YOUR MySQL password.
# src/.env is ignored by Git, so your password never reaches GitHub.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-root-password
DB_NAME=petmed

# Any long random text. It signs the sign-in tokens.
SECRET_KEY=change-this-to-any-long-random-text
